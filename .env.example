# ─── Shared ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
MITRITY_CONTROL_PLANE_URL=https://api.mitrity.com

# ─── Orchestrator agent (Claude Agent SDK; read-only fs__* tools + delegate__delegate_to)
MITRITY_AGENT_ID_ORCHESTRATOR=00000000-0000-0000-0000-000000000000
MITRITY_AGENT_KEY_ORCHESTRATOR=ak_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Data worker agent (data__query_database / data__fetch_orders / data__create_order + delegate__delegate_to)
MITRITY_AGENT_ID_DATA=00000000-0000-0000-0000-000000000000
MITRITY_AGENT_KEY_DATA=ak_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Notification worker agent (notify__send_notification / notify__email_customer + delegate__delegate_to)
MITRITY_AGENT_ID_NOTIFY=00000000-0000-0000-0000-000000000000
MITRITY_AGENT_KEY_NOTIFY=ak_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ──────────────────────────────────────────────────────────────
# Claude model for all three agents (default: claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5
# normal (default) or fast (skip the pauses between scenarios).
MITRITY_DEMO_SPEED=normal
