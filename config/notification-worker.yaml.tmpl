# Rendered by entrypoint.sh into /etc/mitrity/gateway.yaml, mode 0600: the
# rendered file carries the agent key.
agent_id: "${MITRITY_AGENT_ID}"
api_key: "${MITRITY_AGENT_KEY}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

# Each upstream's tools are served under its namespace as <namespace>__<tool>
# (notify__send_notification, notify__email_customer, delegate__delegate_to). Policies target a tool as
# mcp:<namespace>__<tool> (see README).
upstreams:
  - name: "notify"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "notification-worker"]
    namespace: "notify"

  - name: "delegate"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "worker-delegate"]
    namespace: "delegate"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100

# Per-agent credential broker (see orchestrator.yaml.tmpl for context).
# The notification-worker typically holds outbound credentials —
# SMTP / Slack / SendGrid keys — distinct from the data-worker's DB
# credentials. Each agent's grants and rotations are independent.
credentials:
  injection_enabled: true
  cache_ttl_seconds: 30
