# Rendered by entrypoint.sh into /etc/mitrity/gateway.yaml, mode 0600: the
# rendered file carries the agent key.
agent_id: "${MITRITY_AGENT_ID}"
api_key: "${MITRITY_AGENT_KEY}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

# Loopback admission API: the orchestrator's second entrance. The Claude Agent
# SDK's built-in tools (Bash, Write, Edit) never produce an MCP call; the
# mitrity adapter's PreToolUse hook asks this listener before the SDK runs
# them. Unix socket and token file live in /run/mitrity (mode 0700, created
# by the Dockerfile; entrypoint.sh checks the ownership and re-asserts the
# mode).
admission:
  enabled: true
  listen_addr: "unix:/run/mitrity/admission.sock"
  token_file: "/run/mitrity/admission.token"

# Each upstream's tools are served under its namespace as <namespace>__<tool>
# (fs__read_file, fs__list_directory, delegate__delegate_to). Claude Code
# exposes MCP tools to the model as mcp__<server>__<tool>, and the Anthropic
# API accepts tool names matching ^[a-zA-Z0-9_-]{1,128}$ only, so the double
# underscore is the one separator that can be called from the Agent SDK.
# Policies target a tool as mcp:<namespace>__<tool> (see README).
upstreams:
  # Read-only filesystem for the orchestrator. Lets it inspect a customer
  # request file before deciding what to delegate. It is also the
  # orchestrator's only file access: the SDK's own Read, Glob and Grep are
  # disallowed (see orchestrator/runner.py), so every read is judged here.
  # Write access is intentionally absent — the orchestrator must delegate
  # writes to the data-worker (which is what makes the privilege_escalation
  # scenario fire).
  - name: "filesystem"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "orchestrator-fs"]
    namespace: "fs"

  # Delegation tool — the meat of this demo. Calling delegate__delegate_to
  # triggers a governed HTTP POST to the target worker; the gateway captures
  # it as a delegation hop.
  - name: "delegate"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "orchestrator-delegate"]
    namespace: "delegate"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100

# Credential broker injection is enabled on all three agents in this
# demo so customers who provision credentials in their tenant can see
# ${credential:<id>} placeholders in tool args get substituted before
# the call reaches the upstream. No scenario in this demo exercises
# it directly (S1-S6 focus on delegation + threat intel); the
# capability is available for ad-hoc testing. See the sidecar +
# gateway demo Phase 6 for end-to-end demonstrations + dashboard
# setup instructions, all of which apply here unchanged.
credentials:
  injection_enabled: true
  cache_ttl_seconds: 30
