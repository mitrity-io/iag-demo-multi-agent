agent_id: "${MITRITY_AGENT_ID}"
api_key: "${MITRITY_AGENT_KEY}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

upstreams:
  # Read-only filesystem for the orchestrator. Lets it inspect a customer
  # request file before deciding what to delegate. Write access is
  # intentionally absent — the orchestrator must delegate writes to the
  # data-worker (which is what makes the privilege_escalation scenario fire).
  - name: "filesystem"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "orchestrator-fs"]
    namespace: "fs"

  # Delegation tool — the meat of this demo. Calling delegate_to triggers a
  # governed HTTP POST to the target worker; the gateway captures it as a
  # delegation hop.
  - name: "delegate"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "orchestrator-delegate"]
    namespace: "delegate"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100

# Credential broker injection is enabled on all three agents in this
# demo so customers who provision credentials in their tenant can see
# ${credential:<id>} placeholders in tool args get substituted before
# the call reaches the upstream. No scenario in this demo exercises
# it directly (S1-S6 focus on delegation + threat intel); the
# capability is available for ad-hoc testing. See the sidecar +
# gateway demo Phase 6 for end-to-end demonstrations + dashboard
# setup instructions, all of which apply here unchanged.
credentials:
  injection_enabled: true
  cache_ttl_seconds: 30
