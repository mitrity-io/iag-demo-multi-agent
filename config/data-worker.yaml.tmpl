agent_id: "${MITRITY_AGENT_ID}"
api_key: "${MITRITY_AGENT_KEY}"

control_plane:
  base_url: "${MITRITY_CONTROL_PLANE_URL}"

# Each upstream's tools are served under its namespace as <namespace>__<tool>
# (data__query_database, data__create_order, delegate__delegate_to). Policies target a tool as
# mcp:<namespace>__<tool> (see README).
upstreams:
  # DB-shaped tools — read + write. The orchestrator delegates here when it
  # needs persistent data work done.
  - name: "data"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "data-worker"]
    namespace: "data"

  # Workers can also delegate further (worker → worker) with delegate__delegate_to. Needed for the
  # deep-chain / circular scenarios.
  - name: "delegate"
    command: "/usr/local/bin/demo-tools"
    args: ["--role", "worker-delegate"]
    namespace: "delegate"

logging:
  level: "info"
  format: "text"

cache:
  profile_ttl: "1m"
  max_entries: 100

# Per-agent credential broker (see orchestrator.yaml.tmpl for context).
# Each worker has its own MITRITY identity, so credential grants and
# rotation events are scoped per-worker. The data-worker is the
# natural place to grant DB credentials; the notification-worker
# would get separate API keys for its outbound email/Slack tools.
credentials:
  injection_enabled: true
  cache_ttl_seconds: 30
